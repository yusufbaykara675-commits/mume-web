# ----------------------------------------------------------------
# MuMê Mum Atölyesi — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyasını ASLA GitHub'a yüklemeyin.
# ----------------------------------------------------------------

# Sitenin tam adresi (sonunda / olmadan)
SITE_URL="https://mume.com"

# Docker kurulumunda veritabanı şifresi (docker-compose.yml DATABASE_URL'i bundan üretir)
POSTGRES_PASSWORD=""

# PostgreSQL bağlantısı (Docker kurulumunda docker-compose.yml bunu kendisi verir)
DATABASE_URL="postgresql://mume:GUCLU_BIR_SIFRE@localhost:5432/mume?schema=public"
# Havuzsuz (direct) bağlantı — Neon/Vercel bunu otomatik ekler; yerelde aynı adresi yazın
DATABASE_URL_UNPOOLED="postgresql://mume:GUCLU_BIR_SIFRE@localhost:5432/mume?schema=public"

# Yönetim paneli oturum anahtarı — en az 32 karakter rastgele değer.
# Üretmek için: openssl rand -base64 48
AUTH_SECRET=""

# İlk yönetici hesabı (seed ve scripts/create-admin.ts kullanır)
ADMIN_EMAIL="admin@mume.com"
ADMIN_PASSWORD=""

# Görsel depolama: "local" (sunucu diski), "s3" (Cloudflare R2 / AWS S3) veya "blob" (Vercel Blob).
# Boş bırakılırsa: BLOB_READ_WRITE_TOKEN varsa Vercel Blob, yoksa local kullanılır.
STORAGE_DRIVER=""
UPLOAD_DIR="./uploads"

# STORAGE_DRIVER="s3" ise:
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Dosyaların herkese açık temel adresi, ör. https://medya.mume.com
MEDIA_PUBLIC_BASE_URL=""
# Yukarıdaki adresin yalnızca alan adı, ör. medya.mume.com
MEDIA_PUBLIC_HOSTNAME=""

# Ödeme altyapısı — ŞU AN KAPALI. Yalnızca sözleşme imzalandıktan sonra doldurun.
PAYMENT_PROVIDER="none"   # none | iyzico | paytr
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
